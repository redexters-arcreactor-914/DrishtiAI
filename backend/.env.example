# Copy this file to .env and fill in your values.

# Optional — without it an offline rule-based extractor is used.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Face match threshold (cosine similarity, 0–1). ArcFace same-person ≈ 0.4–0.8.
# MATCH_THRESHOLD=0.40

# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=1
# DISABLE_ONLINE_GEOCODING=1
